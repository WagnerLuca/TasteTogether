# Copy to .env and edit, then: docker compose -f docker-compose.prod.yml up -d
# (.env is gitignored — never commit the real values.)

# Image tag to deploy. "latest" follows the default branch; pin a release
# (v1.2.3) or a commit (sha-a1b2c3d) for a reproducible deploy.
IMAGE_TAG=latest

# Host port the app is served on. 8080 by default so it doesn't collide with
# the other Wagner Luca modules on the same machine.
HTTP_PORT=8080

# Postgres password. REQUIRED for anything public-facing — the default is only
# meant for a throwaway local stack. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=tastetogether

# Signs the host (admin) JWTs. REQUIRED — the backend refuses to start without
# it (min. 32 characters). Changing it signs every host out; they log in again
# with their event password. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional: hosts sign in with WL Konto (e.g. https://konto.wagner-luca.de) and own their events.
# Register the client "tastetogether" in Konto first (redirect URI https://<this host>/auth/callback,
# API scope api:tastetogether, webhook https://<this host>/api/konto/webhook + secret).
# The frontend reads KONTO_URL at build time. Empty = off.
KONTO_URL=
KONTO_WEBHOOK_SECRET=

# ── Build-time only, NOT read from this file ──────────────────────────────────
# Building the frontend from source (docker-compose.yml) needs a GitHub Packages
# read:packages token in the *host environment*, because it is passed to BuildKit
# as a secret rather than an env var:
#   export NODE_AUTH_TOKEN=<classic PAT with read:packages>
#   docker compose up --build
