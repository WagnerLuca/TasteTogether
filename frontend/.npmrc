; @wagnerluca/ui is published to GitHub Packages by the design-system repo
; (WagnerLuca/wagnerluca-ui, .github/workflows/publish.yml, on v*.*.* tags).
;
; GitHub Packages requires auth even for reads, so NODE_AUTH_TOKEN must be set:
;   local dev  -> export NODE_AUTH_TOKEN=<classic PAT with read:packages>
;   CI         -> injected from secrets (see .github/workflows/ci-cd.yml)
;   Docker     -> passed in as a BuildKit secret, never as an ARG/ENV layer
@wagnerluca:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

; This is a React app, but @wagnerluca/ui declares vue + vue-router as peers
; (it ships Vue SFCs). We only consume its framework-agnostic half — tokens.css
; and the Tailwind preset — so npm must NOT auto-install those peers into a
; React dependency tree. legacy-peer-deps downgrades the unmet peer to a warning.
; Keep this in sync with the lockfile: it was generated with the same setting,
; so `npm ci` stays reproducible.
legacy-peer-deps=true
